<!DOCTYPE html>
<html lang="en" data-accent="blue">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DURF Dashboards | Progress monitoring for the Dutch Repository Federation</title>
  <meta name="description" content="Progress monitoring for the six DURF project themes.">
  <link rel="icon" type="image/svg+xml" href="https://durf-project.github.io/durf-design-system/assets/favicon.svg">
  <link rel="apple-touch-icon" href="https://durf-project.github.io/durf-design-system/assets/apple-touch-icon.png">
  <meta property="og:image" content="https://durf-project.github.io/durf-design-system/assets/durf-og.png">
  <!-- DURF design system v1.1: Oat UI (vendored), then durf.css, then durf-nav.js (topbar,
       menu, theme button). No defer: the theme must be set before first paint. -->
  <link rel="stylesheet" href="https://durf-project.github.io/durf-design-system/lib/oat.min.css">
  <link rel="stylesheet" href="https://durf-project.github.io/durf-design-system/durf.css">
  <script src="https://durf-project.github.io/durf-design-system/durf-nav.js"></script>
  <style>
    /* Page-specific rules only; colours, fonts, topbar and page head come from durf.css */
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 1.25rem; padding-block: 0; }
    /* .durf-card gives border, radius and background; the bar is the theme colour:
       --durf-theme-N from the slug's theme number, metadata.json "colour" as fallback. */
    .nb-card { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
    .nb-card__bar { height: .375rem; background: var(--card-colour, var(--chart-none)); }
    .nb-card__body { padding: 1rem 1.25rem 1.25rem; display: flex; flex-direction: column; flex: 1; }
    .nb-card__title { font-family: var(--font-heading); font-weight: 700; font-size: 1.0625rem; margin: 0 0 .5rem; }
    .nb-card__desc { color: var(--muted-foreground); font-size: .875rem; line-height: 1.45; flex: 1; margin: 0 0 1rem; }
    .nb-card__image { display: block; width: 100%; height: auto; border-bottom: 1px solid var(--border); }
    .nb-card .button { align-self: flex-start; }
    .durf-page-head .intro { max-width: var(--reading-width); color: var(--muted-foreground); margin: .75rem 0 0; }
  </style>
</head>
<body>
  <header class="durf-page-head compact">
    <div class="durf-shell">
      <h1>DURF Dashboards</h1>
      <p class="intro">Progress monitoring for the six DURF project themes, tracked against the <a href="https://github.com/durf-project/durf-gantt">project roadmap</a>.</p>
    </div>
  </header>

  <main class="durf-shell">
    <div class="grid">
      {% for notebook in notebooks %}
      {% set fallback = notebook.colour or 'var(--chart-none)' %}
      <div class="durf-card nb-card"{% if notebook.theme %} data-theme-n="{{ notebook.theme }}" style="--card-colour: var(--durf-theme-{{ notebook.theme }}, {{ fallback }});"{% else %} style="--card-colour: {{ fallback }};"{% endif %}>
        <div class="nb-card__bar"></div>
        {% if notebook.image %}
        <a href="{{ notebook.html_path }}">
          <img class="nb-card__image" src="{{ notebook.image }}" alt="{{ notebook.title }} screenshot">
        </a>
        {% endif %}
        <div class="nb-card__body">
          <p class="nb-card__title">{{ notebook.title }}</p>
          {% if notebook.description %}
          <p class="nb-card__desc">{{ notebook.description }}</p>
          {% endif %}
          <a href="{{ notebook.html_path }}" class="button outline small">Open dashboard</a>
        </div>
      </div>
      {% endfor %}
    </div>
  </main>

  <footer class="durf-footer">
    <div class="durf-shell">
      <p>
        Tracking progress on the
        <a href="https://github.com/durf-project/durf-gantt" target="_blank">DURF project roadmap</a>.
        For feedback, <a href="https://github.com/durf-project/dashboards/issues" target="_blank">raise an issue</a>.
        Source under <a href="https://github.com/durf-project/dashboards" target="_blank">durf-project/dashboards</a>,
        licensed under the <a href="https://github.com/durf-project/dashboards/blob/HEAD/LICENSE" target="_blank">EUPL v1.2</a>.
      </p>
      <p>Built with <a href="https://marimo.io" target="_blank">marimo</a>.</p>
    </div>
  </footer>
</body>
</html>
